# NOESIS-Harness-Agent-Memory Environment Variables
# Copy this file to .env and fill in your values

# Required for Telegram funnel (BotFarm)
TG_API_ID=your_telegram_api_id
TG_API_HASH=your_telegram_api_hash
TG_GROUP_ID=your_telegram_group_id
TG_SESSION_NAME=tg_user

# Required for X/Twitter integration
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
X_BEARER_TOKEN=your_x_bearer_token

# Optional: Discord webhook for notifications
DISCORD_WEBHOOK_URL=your_discord_webhook

# Optional: LLM compressor for Memory (injected by the app, never required)
# NOESIS_MEMORY_COMPRESSOR=off
# NOESIS_RRF_W_BM25=0.4
# NOESIS_RRF_W_VEC=0.6

# Optional: LLM API keys (for local models)
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
HF_TOKEN=your_huggingface_token

# Optional: Database paths (defaults shown)
# DB_PATH=x_monitor.db
# BOTFARM_DB_PATH=botfarm.db

# Optional: Logging level
# LOG_LEVEL=INFO

# Optional: GPU settings
# NOESIS_GPU_MEMORY_FRACTION=0.9
# NOESIS_CUDA_VISIBLE_DEVICES=0

# Optional: VPN for X/Twitter (if needed)
# BOTFARM_VPN_TOKEN=your_vanya_vpn_token